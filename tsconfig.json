{
  "compilerOptions": {
    "target": "ES202",
    "module": "ESNext",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*",
    "pages/**/*",
    "test-data/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}